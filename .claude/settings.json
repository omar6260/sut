{
  "permissions": {
    "deny": [
      "Bash(firebase deploy*--project suktum-prod*)",
      "Bash(firebase deploy*-P suktum-prod*)",
      "Bash(firebase use suktum-prod*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Edit(/legacy/**)",
      "Write(/legacy/**)"
    ],
    "allow": [
      "Bash(npm run build*)",
      "Bash(npm run test:e2e*)",
      "Bash(npm run test:rules*)",
      "Bash(npm --prefix functions test*)",
      "Bash(npx playwright test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-legacy.sh" }
        ]
      }
    ]
  }
}
