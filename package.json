{
  "name": "suktum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Suktum — réseau social vidéo pour le Sénégal et l'Afrique de l'Ouest. Migration du prototype vers Firebase.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project suktum-dev",
    "test:rules": "firebase emulators:exec --only firestore --project suktum-dev \"node --test tests/rules\"",
    "test:e2e:firebase": "firebase emulators:exec --only auth,firestore --project suktum-dev \"SUKTUM_BACKEND=firebase playwright test --workers=1\"",
    "rules": "node scripts/generate-rules.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.63.0",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.1"
  },
  "dependencies": {
    "firebase": "^10.14.1"
  }
}
